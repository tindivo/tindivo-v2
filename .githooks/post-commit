#!/bin/sh
# Mantiene fresco el grafo de graphify (Docs/README.md §6.5).
# Se activa una vez por clon: git config core.hooksPath .githooks
# Un post-commit no puede bloquear el commit; si graphify no está instalado, no hace nada.
command -v graphify >/dev/null 2>&1 || exit 0
( graphify update . >/dev/null 2>&1 & )
exit 0
