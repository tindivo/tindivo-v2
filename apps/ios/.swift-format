{
  "version": 1,
  "indentation": { "spaces": 4 },
  "lineLength": 120,
  "indentConditionalCompilationBlocks": false,
  "rules": {
    "UseLetInEveryBoundCaseVariable": false,
    "DoNotUseSemicolons": false,
    "NoAccessLevelOnExtensionDeclaration": false,
    "GroupNumericLiterals": false
  }
}
