<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: los avisos del pedido. Se pide después de crear un pedido, nunca al abrir la app (PushPermissionPrompt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- «Usar mi ubicación» del formulario de dirección: una lectura al tocar el botón, en primer plano. Se piden las
         dos para que la persona pueda dar solo la aproximada. Sin ACCESS_BACKGROUND_LOCATION: nunca en segundo plano. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- androidx.credentials los pide para las llaves de acceso (passkeys) con huella. Aquí solo se entra con el ID
         token de Google, que no usa la biometría de la app: se quitan del manifiesto fusionado. -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <!-- usesCleartextTraffic en false de forma explícita: en API 26-27 el valor por defecto permitiría HTTP. -->
    <application
        android:name=".TindivoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tindivo"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Clave del SDK de Maps: la pone el build desde MAPS_API_KEY (ver customer/build.gradle.kts), nunca el repo. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- Avisos nativos (FCM, KT-10). El repo es público: no hay google-services.json ni su plugin. Firebase se inicia a
             mano en TindivoApp con la configuración de BuildConfig, así que el proveedor automático se quita; sin esa
             configuración (la CI) los avisos quedan apagados. Sin Analytics ni token automático. -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- El canal y el icono con que el sistema pinta el aviso cuando la app está en segundo plano. El canal es el que
             manda send-push (order_updates); estos valores solo cubren un mensaje que no lo traiga. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="order_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/push_accent" />

        <!-- ui-tooling (debugImplementation) añade esta actividad EXPORTADA y sin permiso: cualquier app del teléfono
             podría lanzarla y pedirle que dibuje un composable por reflexión. Se quita del manifiesto fusionado; las
             vistas previas del editor siguen funcionando (lo detectó la comprobación del manifiesto final del APK). -->
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />

        <!-- play-services-auth (lo trae credentials-play-services-auth) añade este servicio EXPORTADO para avisar de
             revocaciones al GoogleSignInClient antiguo. Credential Manager no lo usa: se quita. MissingClass: la clase
             vive en el .aar de Google y lint no la ve desde un nodo que solo existe para quitarse. -->
        <service
            android:name="com.google.android.gms.auth.api.signin.RevocationBoundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>

</manifest>
