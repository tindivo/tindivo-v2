<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo builds debug. `androidx.compose.ui:ui-test-manifest` (dependencia debug de las pruebas de UI) declara
  `androidx.activity.ComponentActivity` exportada; aquí se fuerza a no exportada para que el APK de depuración no
  abra una puerta que otra app pueda lanzar (scripts/android-check-manifest.py). Las pruebas no la necesitan
  exportada: la instrumentación corre dentro de la misma app. El release no lleva este archivo.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
