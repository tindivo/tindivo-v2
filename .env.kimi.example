# =============================================================================
# Configuración para Kimi AI (Moonshot AI) / claude-kimi
# Copia las variables a tu archivo .env o .env.local según tu entorno.
# =============================================================================

# 1. Tu API Key de Moonshot AI (obtenla en https://platform.moonshot.cn/)
KIMI_API_KEY="tu_api_key_de_kimi_aqui"
MOONSHOT_API_KEY="tu_api_key_de_kimi_aqui"

# 2. Endpoint URL de Moonshot API (Compatible con OpenAI)
KIMI_BASE_URL="https://api.moonshot.cn/v1"

# 3. Modelo de Kimi a utilizar:
#    - moonshot-v1-8k   (Rápido, 8k tokens de contexto)
#    - moonshot-v1-32k  (32k tokens de contexto)
#    - moonshot-v1-128k (128k tokens de contexto largo)
#    - kimi-k1.5        (Modelo de razonamiento avanzado)
KIMI_MODEL="moonshot-v1-8k"

# 4. Si utilizas un Proxy (ej. LiteLLM / OpenRouter / Claude-Code CLI):
# ANTHROPIC_BASE_URL="https://api.moonshot.cn/v1"
# ANTHROPIC_API_KEY="tu_api_key_de_kimi_aqui"
