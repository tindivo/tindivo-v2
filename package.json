{
  "name": "tindivo",
  "version": "0.0.0",
  "private": true,
  "description": "Tindivo 2.0 — plataforma de delivery hiper-local (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "check:ds": "node scripts/check-design-system.mjs",
    "check:auth": "node scripts/check-auth-boundaries.mjs",
    "check:dialogs": "node scripts/check-dialogs.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:types": "supabase gen types typescript --project-id zpnipajgwfthxhdtzhly --schema public > packages/supabase/src/database.types.ts",
    "db:lint": "supabase db lint --linked --schema public --level warning",
    "db:seed:e2e": "node apps/api/scripts/seed-e2e.ts",
    "db:seed:e2e:clean": "node apps/api/scripts/seed-e2e-clean.ts",
    "db:seed:demo": "node apps/api/scripts/seed-demo-board.ts",
    "db:seed:demo:clean": "node apps/api/scripts/seed-demo-board.ts --clean",
    "db:seed:addresses": "node apps/api/scripts/seed-address-directory.ts",
    "test:e2e": "playwright test --ignore-snapshots",
    "test:e2e:visual": "playwright test --project=visual",
    "graphify:update": "graphify update .",
    "graphify:cluster": "graphify cluster-only .",
    "graphify:query": "graphify query",
    "graphify:path": "graphify path",
    "graphify:explain": "graphify explain",
    "graphify:hooks": "graphify hook install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.62.0",
    "cross-env": "^10.1.0",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
