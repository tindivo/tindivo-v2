# =============================================================================
# Tindivo 2.0 — Plantilla de variables de entorno
# Copia este archivo a `.env.local` en cada app que lo necesite.
# NUNCA commitees `.env.local` (ya está en .gitignore).
# Proyecto Supabase v2: "Web v2" (ref: zpnipajgwfthxhdtzhly)
# =============================================================================

# --- Supabase (público, expuesto al browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://zpnipajgwfthxhdtzhly.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable_anon_key>"

# --- Supabase (servidor, SECRETO — solo apps/api e Edge Functions) ---
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# --- URLs de la plataforma ---
# API REST única consumida por las 4 apps frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# URL pública de la app actual (para callbacks de auth, tracking links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Inngest (scheduling) ---
INNGEST_SIGNING_KEY="<inngest_signing_key>"
INNGEST_EVENT_KEY="<inngest_event_key>"

# --- Web Push / VAPID ---
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<vapid_public_key>"
VAPID_PRIVATE_KEY="<vapid_private_key>"
VAPID_SUBJECT="mailto:soporte@tindivo.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<vapid_public_key>"

# --- Mapas (CARTO basemaps — customer app) ---
# Key gratuita, obtener en: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY="<carto_api_key>"

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL="<upstash_url>"
UPSTASH_REDIS_REST_TOKEN="<upstash_token>"
# Secreto propio del HMAC con que se guarda el teléfono en el contador de OTP
# por número (32+ bytes aleatorios). Con Twilio configurado, es OBLIGATORIA junto con
# las dos de Upstash: sin ellas el build de apps/api falla (scripts/check-sms-config.mjs)
# y send-code responde 503. Sin Twilio (dev, CI, simulacro) no se exigen.
OTP_PHONE_HMAC_SECRET="<otp_phone_hmac_secret>"
# Límite de tasa de las rutas PÚBLICAS por IP: apagado salvo que valga exactamente "true".
# Tener Upstash configurado NO lo enciende; el límite de OTP por número no depende de este flag.
RATE_LIMIT_PUBLIC_ENABLED="false"
# Secreto compartido API <-> Edge Function send-push para las alertas operativas (OpsAlert).
# 32+ bytes aleatorios. Mismo valor en Vercel (apps/api, solo en ejecución) y en
# `supabase secrets set OPS_ALERT_SECRET=...`. Sin él, la alerta no se manda (queda en el log).
OPS_ALERT_SECRET="<ops_alert_secret>"

# --- Observabilidad (opcional en dev) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Reportes PDF (apps/api, solo dev local) ---
# Ruta al Chrome/Edge instalado en tu máquina, para que puppeteer-core lo
# controle al generar el PDF de "Rendimiento". En producción no se usa: ahí se
# lanza @sparticuz/chromium (ver apps/api/lib/pdf/browser.ts).
# Ejemplo Windows: "C:\Program Files\Google\Chrome\Application\chrome.exe"
PUPPETEER_EXECUTABLE_PATH=""
